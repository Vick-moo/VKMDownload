{
  "manifest_version": 3,
  "name": "VKMDownload",
  "version": "1.0.4",
  "description": "把浏览器里的下载交给 VKMDownload，不再让浏览器自己下。",
  "minimum_chrome_version": "103",

  "permissions": ["downloads", "contextMenus", "notifications", "cookies", "storage"],

  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.google.com/*",
    "https://*.googleusercontent.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "VKMDownload"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
